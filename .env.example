# BlackWolf Forex Trading Platform - Environment Configuration

# Server
NODE_ENV=development
PORT=5000
HOST=localhost

# Database
MONGODB_URI=mongodb://localhost:27017/blackwolf
# For MongoDB Atlas, use: mongodb+srv://username:password@cluster.mongodb.net/blackwolf

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
JWT_EXPIRE=7d

# Stripe Payment Integration
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=noreply@blackwolf.com

# API Keys
OPEN_EXCHANGE_RATES_KEY=your_open_exchange_rates_api_key
FIXER_API_KEY=your_fixer_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# Frontend URL
CLIENT_URL=http://localhost:3000

# Redis Cache (optional)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# AWS S3 (for document uploads)
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET=blackwolf-documents

# Security
SESSION_SECRET=your_session_secret_key_here
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# Feature Flags
ENABLE_2FA=true
ENABLE_AUTO_TRADING=true
ENABLE_DEMO_MODE=true
